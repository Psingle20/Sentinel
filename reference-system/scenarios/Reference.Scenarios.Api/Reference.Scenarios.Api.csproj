    <ItemGroup>
        <ProjectReference Include="..\Reference.Scenarios.Application\Reference.Scenarios.Application.csproj" />
        <ProjectReference Include="..\Reference.Scenarios.Infrastructure\Reference.Scenarios.Infrastructure.csproj" />
        <ProjectReference Include="..\..\services\Reference.Common\Reference.Common.csproj" />
        <ProjectReference Include="..\..\..\packages\CleanArchitecture.BuildingBlocks\src\CleanArchitecture.BuildingBlocks.Hosting\CleanArchitecture.BuildingBlocks.Hosting.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\manifests\*.json" LinkBase="manifests" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
