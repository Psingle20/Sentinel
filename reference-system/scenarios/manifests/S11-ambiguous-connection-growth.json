{
  "id": "S11",
  "slug": "ambiguous-connection-growth",
  "version": 1,
  "kind": "confounder",
  "description": "checkout-service v2.4.1 leaks Redis connections, as in S1, and five seconds later order-service v1.7.2 widens its Redis pool from 4 to 40 connections, which then hold steady. Both services' connections rise right after their deployments, so the specialists' evidence fits either; only how many connections each holds at onset separates the leak from the wider pool.",
  "affectedService": "checkout-service",
  "downstreamServices": [
    "order-service"
  ],
  "warmupSeconds": 75,
  "durationSeconds": 240,
  "steps": [
    {
      "atSeconds": 0,
      "action": "deploy",
      "service": "checkout-service",
      "version": "v2.4.1",
      "rolloutSeconds": 20,
      "role": "cause"
    },
    {
      "atSeconds": 5,
      "action": "deploy",
      "service": "order-service",
      "version": "v1.7.2",
      "rolloutSeconds": 20,
      "role": "confounder"
    }
  ],
  "cause": {
    "description": "Deployment of checkout-service v2.4.1, which leaks Redis connections.",
    "service": "checkout-service",
    "change": "deploy checkout-service v2.4.1",
    "activationSeconds": 20
  },
  "confounders": [
    {
      "description": "order-service v1.7.2 widens its Redis pool to 40 connections, which hold steady: a surge right after a deployment that is not a leak.",
      "service": "order-service",
      "change": "deploy order-service v1.7.2",
      "atSeconds": 5,
      "servingFromSeconds": 25
    }
  ],
  "detection": {
    "expectIncident": true,
    "service": "checkout-service",
    "metric": "slo_burn_rate",
    "threshold": 2.0,
    "withinSeconds": 120
  },
  "expectedObservations": [
    {
      "description": "checkout-service's own Redis connections climb after v2.4.1 serves.",
      "query": "sum(reference_redis_clients{client_name=\"checkout-service\"})",
      "expectation": "above",
      "threshold": 100,
      "fromSeconds": 20,
      "withinSeconds": 70
    },
    {
      "description": "Checkout Redis errors appear once Redis is saturated.",
      "query": "sum(rate(reference_checkout_redis_errors_total[1m]))",
      "expectation": "above",
      "threshold": 0,
      "fromSeconds": 20,
      "withinSeconds": 110
    },
    {
      "description": "Order-service calls are retried.",
      "query": "sum(rate(reference_checkout_order_retries_total[1m]))",
      "expectation": "above",
      "threshold": 0,
      "fromSeconds": 20,
      "withinSeconds": 120
    },
    {
      "description": "Checkout SLO burn rate crosses the detection threshold.",
      "query": "slo:checkout_success:burn_rate1m",
      "expectation": "above",
      "threshold": 2.0,
      "fromSeconds": 20,
      "withinSeconds": 120
    }
  ],
  "discriminatingSignals": [
    {
      "description": "checkout-service's own Redis connections keep growing past 100 after v2.4.1 serves.",
      "query": "sum(reference_redis_clients{client_name=\"checkout-service\"})",
      "expectation": "above",
      "threshold": 100,
      "fromSeconds": 20,
      "withinSeconds": 90
    },
    {
      "description": "order-service's Redis connections stop near its pool size of 40.",
      "query": "max_over_time(sum(reference_redis_clients{client_name=\"order-service\"})[3m:5s])",
      "expectation": "below",
      "threshold": 60,
      "fromSeconds": 25,
      "withinSeconds": 150
    }
  ],
  "noise": {
    "trafficRequestsPerSecond": 10,
    "seed": 1011,
    "latencyJitter": 0.1,
    "timingToleranceSeconds": 20,
    "notes": "Request pacing and query latency use seeded jitter. order-service's wider pool fills with traffic, so it reaches 40 connections within a few seconds of serving."
  },
  "hypotheses": {
    "leading": {
      "service": "checkout-service",
      "cause": "checkout-service v2.4.1 introduced a Redis connection leak"
    },
    "rejected": [
      {
        "service": "order-service",
        "cause": "order-service v1.7.2 leaks Redis connections"
      }
    ]
  },
  "remediation": {
    "permitted": [
      {
        "action": "rollback",
        "service": "checkout-service",
        "fromVersion": "v2.4.1",
        "toVersion": "v2.4.0",
        "mode": "approval-required"
      }
    ],
    "falseRemediations": [
      {
        "action": "rollback",
        "service": "order-service"
      }
    ]
  },
  "baseline": {
    "outcome": "rollback",
    "service": "order-service",
    "fromVersion": "v1.7.2",
    "toVersion": "v1.7.0",
    "correct": false
  },
  "recovery": {
    "restoredBy": "rollback checkout-service to v2.4.0",
    "criteria": [
      {
        "description": "Checkout SLO burn rate below 1.",
        "query": "slo:checkout_success:burn_rate1m",
        "comparison": "lessThan",
        "threshold": 1.0
      },
      {
        "description": "checkout-service Redis connections back to its pool size.",
        "query": "sum(reference_redis_clients{client_name=\"checkout-service\"})",
        "comparison": "lessThan",
        "threshold": 20
      }
    ],
    "observationWindowSeconds": 90,
    "evaluationTimeoutSeconds": 300
  }
}
