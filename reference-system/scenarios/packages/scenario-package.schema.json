{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.example.test/schemas/scenario-package/1",
  "title": "Sentinel scenario package",
  "description": "A versioned evaluation case (Phase 07): which reference scenario to run, what to perturb, and the ground truth a run is scored against. The manifest under ../manifests stays the executable definition; the package adds what evaluation needs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "kind", "manifest", "title", "groundTruth"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^S[0-9]+$" },
    "version": { "type": "integer", "minimum": 1, "description": "Bumped whenever the ground truth or perturbations change, so results from different versions are never compared." },
    "kind": { "enum": ["control", "golden", "counterfactual", "failure", "regression"] },
    "manifest": { "type": "string", "pattern": "^S[0-9]+$", "description": "The scenario manifest the run executes." },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "perturbations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "target"],
        "properties": {
          "kind": { "enum": ["provider-outage", "action-failure"] },
          "target": { "type": "string", "description": "A provider resource such as loki, or the system that performs an action, such as deploy-controller." },
          "action": { "type": "string", "description": "For action-failure: the action that fails, for example rollback." },
          "fromSeconds": { "type": "integer", "minimum": 0 },
          "untilSeconds": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "groundTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectIncident", "expectedOutcome", "abstentionAcceptable", "evidence", "permittedActions", "falseRemediations"],
      "properties": {
        "expectIncident": { "type": "boolean" },
        "expectedOutcome": { "enum": ["no-incident", "resolved", "escalated"] },
        "rootCause": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service", "hypothesisKeys"],
          "properties": {
            "service": { "type": "string" },
            "hypothesisKeys": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Accepted key prefixes from the hypothesis-key vocabulary, for example change: or redis-saturation:reporting-worker." },
            "change": {
              "type": "object",
              "additionalProperties": false,
              "required": ["service", "version"],
              "properties": { "service": { "type": "string" }, "version": { "type": "string" } }
            }
          }
        },
        "rejectedCauses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["service", "description"],
            "properties": { "service": { "type": "string" }, "description": { "type": "string" } }
          }
        },
        "abstentionAcceptable": { "type": "boolean", "description": "Whether abstaining is an acceptable outcome, for example when the only permitted action is a suggestion." },
        "evidence": {
          "type": "array",
          "description": "The observations a sound investigation relies on. Evidence that cites none of them does not count as precise.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["metric", "log", "trace", "deployment", "topology"] },
              "service": { "type": "string" },
              "metric": { "type": "string" },
              "role": { "enum": ["cause", "symptom", "discriminating", "confounder"] }
            }
          }
        },
        "expectedMissingEvidence": { "type": "array", "items": { "type": "string" }, "description": "Signals a perturbation removes, which the decision should report as missing." },
        "permittedActions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "service", "mode"],
            "properties": {
              "action": { "type": "string" },
              "service": { "type": "string" },
              "mode": { "enum": ["approval-required", "suggestion-only"] }
            }
          }
        },
        "falseRemediations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "service"],
            "properties": { "action": { "type": "string" }, "service": { "type": "string" } }
          }
        }
      }
    }
  }
}
