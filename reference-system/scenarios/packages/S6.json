{
  "$schema": "./scenario-package.schema.json",
  "schemaVersion": 1,
  "id": "S6",
  "version": 1,
  "kind": "counterfactual",
  "manifest": "S6",
  "title": "Poison message with an innocent consumer deployment",
  "description": "One order message no revision can process keeps failing on every receive while the queue-consumer processes the rest; a benign queue-consumer v1.4.1 deployment serves before the incident opens. Quarantining the message is the remedy; rolling the consumer back is the false remediation, and it would not remove the message.",
  "perturbations": [],
  "groundTruth": {
    "expectIncident": true,
    "expectedOutcome": "resolved",
    "rootCause": {
      "service": "queue-consumer",
      "hypothesisKeys": ["poison-message:queue-consumer", "poison-message"]
    },
    "rejectedCauses": [
      { "service": "queue-consumer", "description": "queue-consumer v1.4.1 deployment" }
    ],
    "abstentionAcceptable": false,
    "evidence": [
      { "kind": "metric", "service": "queue-consumer", "metric": "queue_max_receive_count", "role": "cause" },
      { "kind": "log", "service": "queue-consumer", "role": "cause" },
      { "kind": "metric", "service": "queue-consumer", "metric": "queue_processed_rate", "role": "discriminating" },
      { "kind": "metric", "service": "queue-consumer", "metric": "queue_oldest_message_age", "role": "symptom" },
      { "kind": "metric", "service": "queue-consumer", "metric": "queue_failure_rate", "role": "symptom" },
      { "kind": "deployment", "service": "queue-consumer", "role": "confounder" }
    ],
    "permittedActions": [
      { "action": "quarantine-message", "service": "queue-consumer", "mode": "approval-required" }
    ],
    "falseRemediations": [
      { "action": "rollback", "service": "queue-consumer" }
    ]
  }
}
