{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AgentWorker": {
    "Services": {
      "Ingestion": "http://ingestion-service"
    }
  },
  "Investigation": {
    "Investigator": "model",
    "ShadowBaseline": true,
    "PromptVersion": "investigator-v3",
    "MaxModelTurns": 6,
    "MaxOutputTokens": 4000,
    "MaxPointsPerSeries": 40,
    "Metrics": {
      "slo_burn_rate": "Error-budget burn rate of a service's SLO; above 1 the budget is spent faster than it accrues.",
      "redis_connections": "Open connections to the shared Redis, grouped by the client service that opened them.",
      "latency_p95": "95th-percentile request duration in seconds, per service.",
      "dependency_wait_p95": "95th-percentile time in seconds a service waits on its dependency per attempt.",
      "request_rate": "Requests per second, per service.",
      "error_ratio": "Share of a service's requests that fail.",
      "retry_rate": "Retries per second a service makes to its dependency.",
      "redis_errors": "Redis errors per second a service hits."
    }
  },
  "Model": {
    "Provider": "test-double",
    "Routing": {},
    "Pricing": {
      "InputPerMillionTokens": 0,
      "OutputPerMillionTokens": 0
    },
    "Budget": {
      "TotalLimit": 100,
      "DailyLimit": 15,
      "ModelDailyLimits": {
        "muse-wonder-1.0": 5
      }
    },
    "Meta": {
      "ChatCompletionsUri": "https://api.meta.ai/v1/chat/completions",
      "RequestTimeout": "00:03:00",
      "Profiles": {
        "meta": {
          "Model": "muse-spark-1.3",
          "ModelVersion": "1.3",
          "ReasoningEffort": "medium",
          "ReasoningTokens": 8000,
          "InputPricePerMillionTokens": 1.25,
          "CachedInputPricePerMillionTokens": 0.15,
          "OutputPricePerMillionTokens": 4.25
        },
        "meta-deep": {
          "Model": "muse-spark-1.3",
          "ModelVersion": "1.3",
          "ReasoningEffort": "high",
          "ReasoningTokens": 16000,
          "InputPricePerMillionTokens": 1.25,
          "CachedInputPricePerMillionTokens": 0.15,
          "OutputPricePerMillionTokens": 4.25
        },
        "meta-wonder": {
          "Model": "muse-wonder-1.0",
          "ModelVersion": "1.0",
          "ReasoningEffort": "high",
          "ReasoningTokens": 16000,
          "InputPricePerMillionTokens": 4.00,
          "CachedInputPricePerMillionTokens": 0.20,
          "OutputPricePerMillionTokens": 20.00
        },
        "meta-contributor": {
          "Model": "muse-spark-1.3-contributor",
          "ModelVersion": "1.3",
          "ReasoningEffort": "medium",
          "ReasoningTokens": 8000,
          "InputPricePerMillionTokens": 0.10,
          "CachedInputPricePerMillionTokens": 0.002,
          "OutputPricePerMillionTokens": 0.20
        }
      }
    },
    "TestDouble": {
      "Mode": "Deterministic"
    }
  }
}
