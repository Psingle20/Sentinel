{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning",
      "Orleans": "Warning",
      "Temporalio": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Runtime": {
    "Services": {
      "Executor": "http://executor-service",
      "Ingestion": "http://ingestion-service",
      "Gateway": "http://gateway-service"
    },
    "Detection": [
      {
        "Service": "checkout-service",
        "Metric": "slo_burn_rate",
        "DetectionThreshold": 2.0,
        "OnsetThreshold": 1.0,
        "RequiredSamples": 2,
        "Lookback": "00:10:00",
        "ClearAfter": "00:02:00"
      },
      {
        "Service": "queue-consumer",
        "Metric": "queue_oldest_message_age",
        "DetectionThreshold": 60.0,
        "OnsetThreshold": 10.0,
        "RequiredSamples": 2,
        "Lookback": "00:10:00",
        "ClearAfter": "00:02:00"
      },
      {
        "Service": "queue-consumer",
        "Metric": "queue_duplicate_rate",
        "DetectionThreshold": 0.5,
        "OnsetThreshold": 0.05,
        "RequiredSamples": 2,
        "Lookback": "00:10:00",
        "ClearAfter": "00:02:00"
      },
      {
        "Service": "queue-consumer",
        "Metric": "orders_undelivered_rate",
        "DetectionThreshold": 2.0,
        "OnsetThreshold": 0.5,
        "RequiredSamples": 2,
        "Lookback": "00:10:00",
        "ClearAfter": "00:02:00"
      }
    ],
    "Dependencies": {
      "checkout-service": [ "order-service" ],
      "queue-consumer": [ "order-service" ]
    },
    "BatchServices": [ "reporting-worker" ],
    "QueueServices": {
      "queue-consumer": "orders"
    },
    "RouteServices": {
      "queue-consumer": "orders-route"
    },
    "Owners": {
      "checkout-service": "payments",
      "order-service": "orders",
      "reporting-worker": "analytics",
      "queue-consumer": "fulfilment"
    },
    "Correlation": {
      "MergeWindow": "00:10:00",
      "ReopenWindow": "00:10:00",
      "MaxMergeDistance": 1,
      "MinimumChangeScore": 0.2,
      "ProximityScale": "00:05:00",
      "EdgeRetention": "01:00:00"
    },
    "Investigation": {
      "Roles": [ "metrics", "logs", "traces", "changes", "topology", "knowledge" ],
      "Challenge": true,
      "ReportGrace": "00:00:30"
    },
    "Consensus": {
      "Enabled": true,
      "SourceReliability": {
        "prometheus": 0.9,
        "deploy-controller": 0.9,
        "jaeger": 0.8,
        "loki": 0.7
      },
      "DefaultReliability": 0.6,
      "PartialWeight": 0.6,
      "ContradictionWeight": 1.2,
      "AbstainBelowConfidence": 0.5,
      "MinimumIndependentSupport": 2,
      "DissentMargin": 0.25
    },
    "Workflow": {
      "ApprovalTimeout": "00:30:00",
      "ExecutionTimeout": "00:10:00",
      "ReconciliationTimeout": "00:30:00",
      "RecoveryRetryInterval": "00:00:10"
    },
    "Orleans": {
      "Clustering": "redis",
      "SiloPort": 11111,
      "GatewayPort": 30000
    },
    "Recovery": {
      "checkout-service": [
        { "Metric": "slo_burn_rate", "Comparison": "lessThan", "Threshold": 1.0 }
      ],
      "queue-consumer": [
        { "Metric": "queue_oldest_message_age", "Comparison": "lessThan", "Threshold": 20.0 },
        { "Metric": "queue_failure_rate", "Comparison": "lessThan", "Threshold": 0.02 }
      ]
    },
    "InvestigationWindow": "00:15:00",
    "InvestigationMaxToolCalls": 12,
    "InvestigationMaxModelTokens": 200000,
    "InvestigationTimeout": "00:05:00",
    "ObservationWindow": "00:01:30",
    "EvaluationLag": "00:00:15",
    "EvaluationTimeout": "00:03:00"
  }
}
