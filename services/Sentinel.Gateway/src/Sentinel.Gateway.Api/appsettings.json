{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Services": {
      "Runtime": "http://runtime-service",
      "AgentWorker": "http://agentworker",
      "Executor": "http://executor-service",
      "Ingestion": "http://ingestion-service"
    },
    "Approvals": {
      "AttestationLifetime": "00:15:00"
    },
    "Signing": {
      "RotateAfter": "12:00:00"
    }
  }
}
