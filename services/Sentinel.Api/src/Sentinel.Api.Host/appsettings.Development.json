{
  "Api": {
    "DevIdentity": {
      "Enabled": true,
      "DefaultUser": "responder@example.test",
      "Users": {
        "responder@example.test": [ "responder", "approver" ],
        "viewer@example.test": [ "responder" ],
        "operator@example.test": [ "responder", "operator" ]
      },
      "Tenants": [ "acme" ]
    },
    "Notifications": {
      "Channels": [
        { "Name": "responders-log", "Kind": "log" }
      ],
      "Routes": [
        { "Event": "incident-opened", "MinimumSeverity": "high", "Channel": "responders-log" },
        { "Event": "plan-proposed", "Channel": "responders-log" },
        { "Event": "incident-escalated", "Channel": "responders-log" },
        { "Event": "incident-resolved", "Channel": "responders-log" }
      ]
    }
  }
}