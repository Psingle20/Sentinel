{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Executor": {
    "EmergencyStop": false,
    "PolicyFile": "policies/remediation-policy.json",
    "CapabilityLifetime": "00:02:00",
    "VerifyTimeout": "00:01:30",
    "VerifyPollInterval": "00:00:02",
    "ReconcileAfter": "00:00:20",
    "Services": {
      "Api": "http://api",
      "Runtime": "http://runtime"
    },
    "Adapters": {
      "DeployController": {
        "Endpoint": "http://deploy-controller"
      },
      "ReportingWorker": {
        "Endpoint": "http://reporting-worker"
      }
    }
  }
}
