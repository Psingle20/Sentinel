{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ingestion": {
    "Tenant": "acme",
    "Environment": "reference",
    "PollInterval": "00:00:05",
    "IngestLag": "00:00:10",
    "InitialLookback": "00:02:00",
    "MaxRangePerPull": "00:05:00",
    "MetricStep": "00:00:05",
    "LogLag": "00:00:15",
    "TraceLag": "00:00:15",
    "LateDataOverlap": "00:00:30",
    "TopologyEnabled": true,
    "AlertsEnabled": true,
    "TopologyInterval": "00:01:00",
    "TopologyLookback": "00:10:00",
    "QueryConcurrency": 16,
    "QueryQueueLimit": 64,
    "MetricSeries": [
      {
        "Name": "slo_burn_rate",
        "Expression": "slo:checkout_success:burn_rate1m",
        "Service": "checkout-service",
        "Unit": "ratio",
        "Aggregation": "burn-rate",
        "Window": "00:01:00",
        "Priority": 10
      },
      {
        "Name": "error_ratio",
        "Expression": "slo:checkout_error_ratio:rate1m",
        "Service": "checkout-service",
        "Unit": "ratio",
        "Aggregation": "rate",
        "Window": "00:01:00",
        "Priority": 9
      },
      {
        "Name": "redis_connections",
        "Expression": "sum by (client_name) (reference_redis_clients)",
        "ServiceLabel": "client_name",
        "Unit": "connections",
        "Aggregation": "sum",
        "Priority": 5
      },
      {
        "Name": "request_rate",
        "Expression": "sum by (job) (rate({__name__=~\"reference_(checkout|orders)_requests_total\"}[1m]))",
        "ServiceLabel": "job",
        "Unit": "requests/s",
        "Aggregation": "rate",
        "Window": "00:01:00",
        "Priority": 4
      },
      {
        "Name": "latency_p95",
        "Expression": "max by (job) (histogram_quantile(0.95, sum by (job, le) (rate({__name__=~\"reference_(checkout|orders)_duration_seconds_bucket\"}[1m]))) or label_replace(histogram_quantile(0.95, sum by (job, le) (rate(reference_orders_confirmation_duration_seconds_bucket[1m]))), \"operation\", \"confirmation\", \"\", \"\"))",
        "ServiceLabel": "job",
        "Unit": "seconds",
        "Aggregation": "p95",
        "Window": "00:01:00",
        "Priority": 4
      },
      {
        "Name": "dependency_wait_p95",
        "Expression": "histogram_quantile(0.95, sum by (le) (rate(reference_checkout_order_wait_seconds_bucket[1m])))",
        "Service": "checkout-service",
        "Unit": "seconds",
        "Aggregation": "p95",
        "Window": "00:01:00",
        "Priority": 3
      },
      {
        "Name": "retry_rate",
        "Expression": "sum(rate(reference_checkout_order_retries_total[1m]))",
        "Service": "checkout-service",
        "Unit": "retries/s",
        "Aggregation": "rate",
        "Window": "00:01:00",
        "Priority": 3
      },
      {
        "Name": "queue_oldest_message_age",
        "Expression": "max(reference_queue_oldest_message_age_seconds)",
        "Service": "queue-consumer",
        "Unit": "seconds",
        "Aggregation": "max",
        "Priority": 8
      },
      {
        "Name": "queue_max_receive_count",
        "Expression": "max(reference_queue_max_receive_count)",
        "Service": "queue-consumer",
        "Unit": "receives",
        "Aggregation": "max",
        "Priority": 6
      },
      {
        "Name": "queue_processed_rate",
        "Expression": "sum(rate(reference_queue_messages_total{outcome=\"processed\"}[1m]))",
        "Service": "queue-consumer",
        "Unit": "messages/s",
        "Aggregation": "rate",
        "Window": "00:01:00",
        "Priority": 5
      },
      {
        "Name": "queue_failure_rate",
        "Expression": "sum(rate(reference_queue_messages_total{outcome=\"failed\"}[1m]))",
        "Service": "queue-consumer",
        "Unit": "messages/s",
        "Aggregation": "rate",
        "Window": "00:01:00",
        "Priority": 6
      },
      {
        "Name": "queue_retry_rate",
        "Expression": "sum(rate(reference_queue_retries_total[1m])) or vector(0)",
        "Service": "queue-consumer",
        "Unit": "attempts/s",
        "Aggregation": "rate",
        "Window": "00:01:00",
        "Priority": 6
      },
      {
        "Name": "queue_duplicate_rate",
        "Expression": "sum(rate(reference_queue_duplicates_total[1m])) or vector(0)",
        "Service": "queue-consumer",
        "Unit": "bookings/s",
        "Aggregation": "rate",
        "Window": "00:01:00",
        "Priority": 6
      },
      {
        "Name": "redis_errors",
        "Expression": "sum(rate(reference_checkout_redis_errors_total[1m]))",
        "Service": "checkout-service",
        "Unit": "errors/s",
        "Aggregation": "rate",
        "Window": "00:01:00",
        "Priority": 3
      }
    ],
    "LogSources": [
      {
        "Name": "service-warnings",
        "Query": "{service_name=~\"checkout-service|order-service|reporting-worker|queue-consumer\"} | severity_text=~\"(?i)warn.*|error|fatal|critical\"",
        "ServiceLabel": "service_name",
        "Limit": 500,
        "Priority": 6
      }
    ],
    "TraceSources": [
      {
        "Name": "request-path",
        "Services": [ "checkout-service", "order-service" ],
        "SlowerThan": "00:00:00.500",
        "SlowTraceLimit": 20,
        "SampleTraceLimit": 3
      }
    ]
  }
}